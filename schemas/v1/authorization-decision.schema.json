{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trust.foundation/schemas/v1/authorization-decision.schema.json",
  "title": "ATF Authorization Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "decision_id", "request_id", "outcome", "policy_version"],
  "properties": {
    "protocol_version": {"const": "atf/v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["ALLOW", "DENY", "REQUIRE_HUMAN"]},
    "policy_version": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "reason_code": {"type": "string"}
  }
}
