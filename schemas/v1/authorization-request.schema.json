{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trust.foundation/schemas/v1/authorization-request.schema.json",
  "title": "ATF Authorization Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "subject", "action", "resource"],
  "properties": {
    "protocol_version": {"const": "atf/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/reference"},
    "action": {"type": "string", "minLength": 1},
    "resource": {"$ref": "#/$defs/reference"},
    "context": {"type": "object"},
    "capability_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string"}}
    }
  }
}
