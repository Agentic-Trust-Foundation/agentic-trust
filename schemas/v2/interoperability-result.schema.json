{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentic-trust.foundation/schemas/v2/interoperability-result.schema.json","title":"ATF V2 Interoperability Result","type":"object","additionalProperties":false,"required":["vector_id","protocol_version","implementation","input_digest","expected_decision","actual_decision","result","evidence_reference"],"properties":{"vector_id":{"type":"string","minLength":1},"protocol_version":{"type":"string","pattern":"^atf/v2$"},"implementation":{"type":"string","minLength":1},"input_digest":{"type":"string","minLength":1},"expected_decision":{"enum":["ALLOW","DENY","REQUIRE_HUMAN"]},"actual_decision":{"enum":["ALLOW","DENY","REQUIRE_HUMAN"]},"result":{"enum":["PASS","FAIL"]},"evidence_reference":{"type":"string","minLength":1}}}